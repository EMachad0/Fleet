    "better-auth": "~1.5.6",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "convex-helpers": "^0.1.115",
    "formsnap": "^2.0.1",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.3.6"
  }
